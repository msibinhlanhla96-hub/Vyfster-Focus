# VYFSTER FOCUS - Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL: Supabase Service Role Key (for privileged server operations)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OPTION 1: Resend Email Integration (Recommended, 3000 free emails/mo at resend.com)
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=Vyfster Focus <onboarding@resend.dev>

# OPTION 2: Gmail or Custom SMTP (Alternative free email dispatch)
# SMTP_USER=yourcorridor@gmail.com
# SMTP_PASS=your-16-char-gmail-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
